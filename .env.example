# Database Configuration
# For local development, use individual variables:
DB_NAME=garden_db
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# For production deployment (Heroku, Railway, etc.), use database URL:
# DB_URL=postgresql://username:password@host:port/database

# Session Secret (change this to a random string for security)
SESSION_SECRET=your_super_secret_session_key_change_this

# Optional: Port for local development (defaults to 3001)
# PORT=3001