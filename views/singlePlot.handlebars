
<main class="garden-interface">
  <!-- Garden Visualization Area -->
  <section id="gardenView">
    <svg id="treeContainer" class="plantContainer"></svg>
    <svg id="bushContainer" class="plantContainer"></svg>
    <svg id="flowerContainer" class="plantContainer"></svg>
  </section>
  
  <!-- Position Controls -->
  <div class="position-controls">
    <label class="control-label">Plant Position:</label>
    <input
      type="range"
      id="plantPosition"
      name="position"
      min="0"
      max="400"
      value="200"
      step="1"
    />
    <div class="position-labels">
      <span>Left</span>
      <span id="positionLabel" class="position-value">200</span>
      <span>Right</span>
    </div>
  </div>

  <!-- Plant Control Form -->
  <form id="addPlantForm" class="plant-form">
    <h2 class="form-title">Add Plants</h2>
    
    <div class="hidden" id="plotIdFromLogin">{{plotId}}</div>
    
    <!-- Plant Type Selection -->
    <div class="input-section">
      <label class="section-label">Plant Type:</label>
      <div class="plant-type-options">
        <div class="radio-option">
          <input type="radio" name="plantType" id="typeTree" value="tree" checked>
          <label for="typeTree">Tree</label>
        </div>
        <div class="radio-option">
          <input type="radio" name="plantType" id="typeBush" value="bush">
          <label for="typeBush">Bush</label>
        </div>
        <div class="radio-option">
          <input type="radio" name="plantType" id="typeFlower" value="flower">
          <label for="typeFlower">Flower</label>
        </div>
      </div>
    </div>

    <!-- Plant Variety Selection -->
    <div class="input-section" id="varietySection">
      <label class="section-label">Variety:</label>
      <div id="varietyOptions" class="variety-options">
        <div class="radio-option">
          <input type="radio" name="plantVariety" id="variety1" value="1" checked>
          <label for="variety1">Apple</label>
        </div>
        <div class="radio-option">
          <input type="radio" name="plantVariety" id="variety2" value="2">
          <label for="variety2">Orange</label>
        </div>
        <div class="radio-option">
          <input type="radio" name="plantVariety" id="variety3" value="3">
          <label for="variety3">Plum</label>
        </div>
      </div>
    </div> 

    <button type="submit" class="plant-btn" id="plantButton">Plant</button>
  </form>
</main>


<script src="/garden/addPlant/addTree.js"></script>
<script src="/garden/addPlant/addBush.js"></script>
<script src="/garden/addPlant/addFlower.js"></script>
<script src="/garden/form/form.js"></script>
<script src="/garden/misc.js"></script>





<script src="/garden/growPlant/growTree.js"></script>
<script src="/garden/growPlant/growBush.js"></script>
<script src="/garden/growPlant/growFlower.js"></script>
<script src="/garden/time.js"></script>